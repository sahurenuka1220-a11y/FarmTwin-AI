# IBM Watson/watsonx credentials
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Langflow credentials
LANGFLOW_API_URL=https://your-langflow-instance.ibm.com
LANGFLOW_API_KEY=your_langflow_api_key_here
LANGFLOW_FLOW_ID=your_langflow_flow_id_here

# IBM watsonx Orchestrate
ORCHESTRATE_API_KEY=your_orchestrate_api_key_here
ORCHESTRATE_INSTANCE_URL=https://api.us-south.watsonx-orchestrate.ai.cloud.ibm.com

# IBM Granite Model IDs
GRANITE_TEXT_MODEL=ibm/granite-13b-instruct-v2
GRANITE_VISION_MODEL=ibm/granite-vision-3-2b

# App Settings
SECRET_KEY=farmtwin-secret-key-change-in-production
DATABASE_URL=sqlite:///./farmtwin.db
UPLOAD_DIR=uploads
DEMO_MODE=true

# App Meta
APP_NAME=FarmTwin AI
APP_VERSION=1.0.0
